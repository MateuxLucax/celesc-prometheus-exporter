# Copy to .env and adjust. Every value here is optional; the defaults are a
# regular residential customer of Celesc (Santa Catarina).

# Which ANEEL tariff row to use (columns of the "tarifas homologadas" dataset).
DISTRIBUIDORA=CELESC
SUBGRUPO=B1
MODALIDADE=Convencional
CLASSE=Residencial
SUBCLASSE=Residencial

# ICMS in percent, as on your bill. SC residential: 12 up to 150 kWh/month,
# 17 above.
ICMS_PERCENT=17

# PIS/COFINS in percent. Leave both empty to read them monthly from the Celesc
# tariff page; set both to pin them (required for distributors other than
# CELESC).
PIS_PERCENT=
COFINS_PERCENT=

# Monthly street-lighting fee (COSIP/CIP) in R$, from your bill. 0 or empty
# leaves the metric out.
COSIP_REAIS_MES=

# How often to re-read ANEEL and Celesc (Go duration, minimum 1m).
REFRESH_INTERVAL=6h

# Decides which month's flag and PIS/COFINS apply.
TZ=America/Sao_Paulo
